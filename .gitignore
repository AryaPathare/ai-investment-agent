# --- Secrets ----------------------------------------------------------------
# Never commit real keys. The .env.* pattern catches variants like .env.local
# so a future file can't slip through; the ! line re-includes the template,
# which contains no real values and SHOULD be committed.
.env
.env.*
!.env.example

# --- Python -----------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Eval run artifacts (re-runnable; not source)
evals/results/

# Cached API responses (re-fetchable; not source)
.cache/

# Cached company data (re-fetchable; not source)

# Saved runs (NOT re-fetchable - a paused session lives here, so unlike
# .cache/ above, deleting this loses a user's in-progress work)
.state/
