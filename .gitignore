# --- Secrets ----------------------------------------------------------------
# Never commit real keys. The .env.* pattern catches variants like .env.local
# so a future file can't slip through; the ! line re-includes the template,
# which contains no real values and SHOULD be committed.
.env
.env.*
!.env.example

# --- Python -----------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Eval run artifacts (re-runnable; not source)
#
# `**/` and NOT `evals/results/`. A pattern containing a slash is anchored to
# this file's directory, so `evals/results/` matched only at the repository
# root - and the moment session 22 moved evals/ into backend/ it silently
# stopped matching, and 37 artifact files were committed into a public
# repository that had deliberately never tracked them. The rule was correct and
# something moved underneath it, which is the same shape as render.yaml pinning
# a Python version through a key that does not exist. test_repository_hygiene
# now fails if any of these are tracked again.
**/evals/results/

# A personal saved profile. `--save-profile mine.json` is the documented way to
# keep your own answers, and those answers are an age, an amount of money and a
# risk tolerance - which belong on your disk and not in a public repository.
**/mine.json

# Cached API responses (re-fetchable; not source)
.cache/

# Cached company data (re-fetchable; not source)

# Saved runs (NOT re-fetchable - a paused session lives here, so unlike
# .cache/ above, deleting this loses a user's in-progress work)
.state/
