# ------------------------------------------------------------------
# Template for the .env file.
#
# .env holds REAL secrets and is gitignored — it never leaves your machine.
# .env.example holds only the NAMES and is committed, so anyone cloning this
# repo (including you on a new machine) knows which keys the app needs.
#
# Setup:  copy this file to .env, then fill in the real values.
#     Windows PowerShell:  Copy-Item .env.example .env
# ------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# LLM provider. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional ---------------------------------------------------------------

# Model to use. Defaults to openai/gpt-oss-20b if left unset.
# GROQ_MODEL=openai/gpt-oss-20b

# Tracing/observability. Get a key at https://smith.langchain.com
# When enabled, every LLM call and graph step is recorded in the LangSmith UI.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ai-investment-agent

# News search for Agent 2. Free key at https://www.thenewsapi.com
NEWS_API_KEY=

# US company fundamentals for Agent 3. Free key, no card, at
# https://site.financialmodelingprep.com  (free tier is US exchanges only;
# non-US companies are served by yfinance, which needs no key)
FMP_API_KEY=

# --- Web front end -----------------------------------------------------------

# Signs the cookie saying which runs a visitor started, so one person cannot
# answer another's clarification. Set this for ANY deployment: left unset the
# server generates one per process, which means a restart stops visitors
# resuming a run they had paused. The runs themselves survive either way - they
# are in the checkpoint database, and `python -m cli --resume <id>` reads any of
# them. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
WEB_SESSION_SECRET=
